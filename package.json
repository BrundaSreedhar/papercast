{
  "name": "paper-to-podcast",
  "version": "2.0.0",
  "description": "Turn academic papers into faithful, two-host podcast episodes — model-agnostic (Claude / OpenAI / open) and eval-backed.",
  "scripts": {
    "generate": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.node.json",
    "typecheck": "tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . ",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "eval:validate": "tsx src/validate-judge.ts",
    "eval": "tsx src/eval.ts",
    "audio": "tsx src/audio.ts",
    "serve": "tsx src/server.ts",
    "dev": "next dev",
    "build:web": "next build",
    "start": "next start",
    "learn": "tsx src/learn.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "multer": "^2.0.1",
    "next": "^16.3.1",
    "openai": "^4.104.0",
    "pdf-parse": "^1.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "@types/multer": "^1.4.7",
    "@types/node": "^20.5.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^4.0.0"
  }
}
