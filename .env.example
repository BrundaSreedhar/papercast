# ─── Provider selection ─────────────────────────────────────────────
# Which model powers script generation: "anthropic" | "openai" | "open"
LLM_PROVIDER=anthropic

# ─── Anthropic (Claude) ─────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Model id, e.g. claude-sonnet-5 / claude-opus-4-8
ANTHROPIC_MODEL=claude-sonnet-5

# ─── OpenAI ─────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# TTS (free/cheap): model + a default voice
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# ─── Open model (OpenAI-compatible endpoint) ────────────────────────
# Point at a hosted free tier (Together / Groq / OpenRouter) OR local Ollama.
# Together:   https://api.together.xyz/v1
# Groq:       https://api.groq.com/openai/v1
# OpenRouter: https://openrouter.ai/api/v1
# Ollama:     http://localhost:11434/v1
#
# Pick a model your host can actually run. Rough local RAM needs:
#   qwen2:7b      ~5 GB   (default — small but capable, good for smoke tests)
#   qwen2.5:14b   ~9 GB   (better quality; comfortable on a 16-18 GB machine)
#   llama3.3:70b  ~40 GB+ (needs a large workstation, or use a hosted tier)
# Hosted tiers have no local RAM cost — just change OPEN_BASE_URL and OPEN_MODEL.
OPEN_BASE_URL=http://localhost:11434/v1
OPEN_API_KEY=ollama
OPEN_MODEL=qwen2:7b

# ─── Text to speech ─────────────────────────────────────────────────
# "piper"  open-source neural voices, free, best quality of the local options
# "say"    built-in macOS voices, free, no setup at all
# "openai" hosted voices, needs OPENAI_API_KEY above (~$0.09 per episode)
# Leave unset to prefer Piper when installed and fall back to say.
# TTS_PROVIDER=piper
PIPER_BIN=.venv-tts/bin/piper
PIPER_HOST_VOICE=.voices/en_US-lessac-medium.onnx
PIPER_GUEST_VOICE=.voices/en_US-ryan-medium.onnx

# ─── Server ─────────────────────────────────────────────────────────
PORT=8000

# ─── Tracing (optional) ──────────────────────────────────────────────
# The only env vars here defined by someone else: these are the OpenTelemetry
# standard names, so every collector tutorial applies unchanged. Everything
# else in this project toggles by CLI flag instead.
#
# Point at any OTLP/HTTP collector to export spans. Unset means no export —
# `--trace` still prints a span tree to the terminal with nothing running.
#   docker run --rm -p 16686:16686 -p 4318:4318 jaegertracing/all-in-one
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Name this service appears under. Defaults to paper-to-podcast.
# OTEL_SERVICE_NAME=paper-to-podcast

# Record prompt and response TEXT on spans, truncated. Off by default: the
# paper travels as ~120k characters on every judge call, and a trace should
# not quietly become a copy of it. Same effect as --trace-payloads.
# OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true

# Standard OTel kill switch: disables tracing regardless of the above.
# OTEL_SDK_DISABLED=true

# ─── Public demo (optional) ──────────────────────────────────────────
# Set on a deployment anyone can open. It turns off uploads and offers the
# fixed shelf in demo/papers.json instead, so a public URL cannot spend an API
# key on an arbitrary file. Unset — the local default — everything is allowed.
# DEMO_MODE=1

# What the demo will do before it says no. The concurrency limit protects the
# machine (synthesis holds a voice model in memory); the daily one protects the
# bill, and is the limit that matters once a link is passed around.
# DEMO_MAX_MINUTES=4
# DEMO_CONCURRENT_JOBS=1
# DEMO_DAILY_JOBS=25
