# ─── Provider selection ─────────────────────────────────────────────
# Which model powers script generation: "anthropic" | "openai" | "open"
LLM_PROVIDER=anthropic

# ─── Anthropic (Claude) ─────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Model id, e.g. claude-sonnet-5 / claude-opus-4-8
ANTHROPIC_MODEL=claude-sonnet-5

# ─── OpenAI ─────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# TTS (free/cheap): model + a default voice
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# ─── Open model (OpenAI-compatible endpoint) ────────────────────────
# Point at a hosted free tier (Together / Groq / OpenRouter) OR local Ollama.
# Together:   https://api.together.xyz/v1
# Groq:       https://api.groq.com/openai/v1
# OpenRouter: https://openrouter.ai/api/v1
# Ollama:     http://localhost:11434/v1
#
# Pick a model your host can actually run. Rough local RAM needs:
#   qwen2:7b      ~5 GB   (default — small but capable, good for smoke tests)
#   qwen2.5:14b   ~9 GB   (better quality; comfortable on a 16-18 GB machine)
#   llama3.3:70b  ~40 GB+ (needs a large workstation, or use a hosted tier)
# Hosted tiers have no local RAM cost — just change OPEN_BASE_URL and OPEN_MODEL.
#
# The base URL decides more than latency. A model on localhost is free, so the
# app warms it on every page view and sends retrieved sections rather than
# whole papers. Point this at a hosted endpoint and both switch off, because
# there they cost money — see openModelIsLocal() in lib/config/env.ts. For a
# free public demo, prefer a tier that refuses when it runs out over one that
# keeps billing: Groq's free tier serves openai/gpt-oss-120b and qwen/qwen3.8-27b
# and returns 429, and OpenRouter's ":free" models do the same.
OPEN_BASE_URL=http://localhost:11434/v1
OPEN_API_KEY=ollama
OPEN_MODEL=qwen2:7b

# ─── Text to speech ─────────────────────────────────────────────────
# "gemini" hosted, the best-sounding option and nothing to install; needs
#          GEMINI_API_KEY above. The TTS models are preview models and answer
#          "high demand" under load, so synthesis retries before giving up.
# "piper"  open-source neural voices, free, best quality of the local options
# "say"    built-in macOS voices, free, no setup at all
# "openai" hosted voices, needs OPENAI_API_KEY above (~$0.09 per episode)
# Leave unset to prefer Piper when installed and fall back to say — the default
# stays free and local, and a hosted voice is opted into rather than assumed.
# TTS_PROVIDER=gemini
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# Prebuilt Gemini voice names. Narrator is separate so a solo or ELI5 episode
# does not sound identical to the host of a dialogue.
GEMINI_HOST_VOICE=Kore
GEMINI_GUEST_VOICE=Puck
GEMINI_NARRATOR_VOICE=Charon
# If a hosted voice fails, a local one remakes the whole episode rather than
# the job failing — the two run at different sample rates, so resuming is not
# an option and restarting locally costs seconds. Defaults to Piper, then say.
# Set to "none" to see the failure instead of a different voice.
# TTS_FALLBACK=piper
# TTS_PROVIDER=piper
PIPER_BIN=.venv-tts/bin/piper
PIPER_HOST_VOICE=.voices/en_US-lessac-medium.onnx
PIPER_GUEST_VOICE=.voices/en_US-ryan-medium.onnx

# ─── Server ─────────────────────────────────────────────────────────
PORT=8000

# ─── Tracing (optional) ──────────────────────────────────────────────
# The only env vars here defined by someone else: these are the OpenTelemetry
# standard names, so every collector tutorial applies unchanged. Everything
# else in this project toggles by CLI flag instead.
#
# Point at any OTLP/HTTP collector to export spans. Unset means no export —
# `--trace` still prints a span tree to the terminal with nothing running.
#   docker run --rm -p 16686:16686 -p 4318:4318 jaegertracing/all-in-one
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Name this service appears under. Defaults to paper-to-podcast.
# OTEL_SERVICE_NAME=paper-to-podcast

# Record prompt and response TEXT on spans, truncated. Off by default: the
# paper travels as ~120k characters on every judge call, and a trace should
# not quietly become a copy of it. Same effect as --trace-payloads.
# OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true

# Standard OTel kill switch: disables tracing regardless of the above.
# OTEL_SDK_DISABLED=true

# ─── Public demo (optional) ──────────────────────────────────────────
# Set on a deployment anyone can open. It turns off uploads and offers the
# fixed shelf in demo/papers.json instead, so a public URL cannot spend an API
# key on an arbitrary file. Unset — the local default — everything is allowed.
# DEMO_MODE=1

# What the demo will do before it says no. The concurrency limit protects the
# machine (synthesis holds a voice model in memory); the daily one protects the
# bill, and is the limit that matters once a link is passed around.
# DEMO_MAX_MINUTES=4
# DEMO_CONCURRENT_JOBS=1
# DEMO_DAILY_JOBS=25

# Questions have their own allowance, because they cost a different amount: a
# question is a handful of calls from the agent as it reads the paper, where an
# episode is minutes of model time. Separate limits also mean a day's episodes
# running out still leaves the shelf listenable and askable.
# DEMO_CONCURRENT_QUESTIONS=2
# DEMO_DAILY_QUESTIONS=200

# Let visitors bring their own paper instead of only picking from the shelf.
# Off by default, and deliberately so: a public URL that accepts any file is a
# bill with no ceiling. Turn it on only behind a provider that refuses when it
# runs out — a free tier that returns 429 — rather than one that keeps billing.
# The daily limits above are then what bounds the day.
# DEMO_ALLOW_UPLOADS=1

# ─── Gemini ─────────────────────────────────────────────────────────
# Reached over Google's OpenAI-compatible endpoint, so it reuses the same
# adapter as the open models rather than pulling in a second SDK.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Override only if Google moves the compatibility endpoint.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Print each model call to the terminal as it finishes: which model, tokens in
# and out, how long, and whether it failed. For when you want to see what is
# happening without standing up a collector.
# TRACE_LOG=1

# ─── Tracing ────────────────────────────────────────────────────────
# Spans follow the OpenTelemetry GenAI conventions, so they open in any OTLP
# backend. Set an endpoint and the whole run goes there:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# LangSmith speaks OTLP too, so it needs a key rather than an SDK. Setting one
# is enough — no flag, and it runs alongside any endpoint above.
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=papercast
# LANGSMITH_TRACING=false        # keep the key, send nothing

# Every span written out in full, one JSON object per line: the prompts, the
# retrieved sections, each chunk handed to the voice, the finished script.
# TRACE_DETAIL_FILE=trace.jsonl

# Prompts, responses and the transcript are omitted unless this is on. Off by
# default because the paper rides along on every judge call, and a trace should
# not quietly become a copy of a document somebody gave you in confidence.
# OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true
